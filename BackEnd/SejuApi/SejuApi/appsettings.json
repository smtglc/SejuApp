{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { //DbBağlanmaYolu
    "sqlConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SejuDb;Trusted_Connection = true;"
  },
  "JwtSettings": {
    "validIssuer": "bsstoreapi", // Token'ı üreten (yayınlayan) API'nin adı. Doğrulamada token'daki issuer ile eşleşmezse token reddedilir.
    "validAudience": "http://localhost:3000", // Token'ın hangi istemci için üretildiği (burada frontend uygulamasının adresi)
    "expires": 60 // Token'ın geçerlilik süresi (dakika). 60 dakika sonra token geçersiz olur.
  }
}
